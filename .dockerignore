# Environment variables and secrets - NEVER include in Docker image
.env
.env.local
.env.*.local
.env.secret

# Credentials and sensitive files
*.pem
*.key
*.crt
id_rsa*
id_ed25519*
credentials.json

# Version control
# NOTE: .git is needed for setuptools_scm to detect version during pip install
# Only exclude .gitignore and .gitattributes
.gitignore
.gitattributes

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# Virtual environments
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test and development
.pytest_cache
.mypy_cache
.dmypy.json
dmypy.json
tests/
test_*.py
conftest.py

# Workspace and build artifacts
workspace/
builds/
DATA/
_build/
*.log

# Docker-related
docker-compose.override.yml
Dockerfile.dev

# Node modules (if present)
node_modules/
npm-debug.log

# OS files
Thumbs.db
.DS_Store
